# Server-only Google Drive service account. Share the Drive folder with this account.
# Keep the private key secret and never expose it with a VITE_ prefix.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=1JsP821wxHi5argotqQLlqtB2ua8btgnJ
# Optional: required only for Workspace domain-wide delegation/impersonation.
GOOGLE_DRIVE_IMPERSONATED_USER=
ADMIN_CODE=
